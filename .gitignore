# ── 系统 / 杂物 ──
.DS_Store
.trash/

# ── Obsidian 个人状态(布局/光标/缓存/统计,不该公开,clone 后会自动重建) ──
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
# vault-stats.json 随演示库分发，供首页字数热力图开箱即显示真实数据（非隐私，纯 demo 统计）
.obsidian/file-recovery.json
.obsidian/plugins/remember-cursor-position/cursor-positions.json

# ── learning-system 个人学习/复习运行数据(删除历史/时间戳/文件路径,模板用不到,clone 后自动重建) ──
.obsidian/plugins/learning-system/data/

# ── 第三方主题(体积膨胀 + 许可顾虑,只保留 demo 启用的 Minimal) ──
.obsidian/themes/*
!.obsidian/themes/Minimal/

# ── 插件个人数据 data.json(含抓取缓存/个人配置,无需随模板分发) ──
# 说明:删掉后 clone 的人首次用该插件回到默认设置即可,不影响 demo 运行。
# 保留的是 demo 跑起来必需的纯配置(templater/periodic-notes/homepage/calendar/tasks/dataview/icon-folder 等)。
.obsidian/plugins/obsidian-media-db-plugin/data.json
.obsidian/plugins/obsidian-excalidraw-plugin/data.json
.obsidian/plugins/quickadd/data.json
.obsidian/plugins/recent-files-obsidian/data.json
.obsidian/plugins/better-word-count/data.json

# ── 兜底:防止任何带密钥的文件混入(如需新增带 key 的插件,显式在此排除其 data.json) ──
*.key
*.pem
.env
